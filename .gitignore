# ── 언더바로 시작하는 것은 올리지 않는다 ──────────────────────────────────
# 원본 고객 자료, 대용량 영상 본보기, 보낸 프롬프트 원문, 실행 기록.
# 없어도 결과물(원고 HTML·검수표·엑셀)을 읽는 데 지장 없다.

# 원본 교육과정 xlsx, 차시설계 입력 xlsx (고객 자료)
_context/
# 45분 영상 본보기 979MB (mp4 · wav · png)
_45min-assets/
# 강마다 보낸 프롬프트와 받은 응답 원문
_prompts/
# 실행 기록
_log/
_local/

# 산출물 — 납품 계약 산출물이라 공개 저장소에 두지 않는다.
# 로컬에는 그대로 있고, 전달은 _share 의 ZIP 으로 한다.
data/

__pycache__/
*.pyc
~$*.xlsx
*.tmp

# 강 폴더 안의 언더바 로그
_s05.log
_*.log

# 공유용 ZIP
_share/

# 이 사업이 어디를 위한 것인지 — 이름만 담은 로컬 파일
pack/site.yaml
